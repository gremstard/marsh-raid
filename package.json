{
  "name": "marsh-raid",
  "productName": "Marsh Raid",
  "version": "0.1.0",
  "description": "Top-down PvE extraction shooter with ducks. Standalone HTML5 game wrapped with Electron (macOS) and Capacitor (Android/iOS).",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && electron .",
    "serve": "npm run build && python3 -m http.server 8765 --directory dist",
    "mac": "npm run build && electron-builder --mac --publish never",
    "cap:sync": "npm run build && npx cap sync",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../release/MarshRaid-android-debug.apk",
    "ios:open": "npm run cap:sync && npx cap open ios"
  },
  "build": {
    "appId": "com.gremstard.marshraid",
    "productName": "Marsh Raid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2"
  }
}
